# ClutchPro · Landing — variáveis de ambiente
# ============================================
# Copie este arquivo para `.env.local` e preencha os valores.
# `.env.local` é ignorado pelo git (não sobe pro repositório).
# Na Vercel/Netlify, cadastre estas mesmas variáveis em "Environment Variables".

# --- Supabase (captura de leads) ---------------------------------------------
# Pegue em: Supabase → Project Settings → API
#   SUPABASE_URL              = "Project URL"
#   SUPABASE_SERVICE_ROLE_KEY = "service_role" (em "Project API keys")
# ⚠️ A service_role key é SECRETA. Nunca use prefixo NEXT_PUBLIC_ nela
#    e nunca a exponha no front-end.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Contato público ----------------------------------------------------------
# Email exibido como canal de contato no rodapé (link mailto).
# Pode deixar vazio por enquanto — o link de contato só aparece quando preenchido.
NEXT_PUBLIC_CONTACT_EMAIL=
